# OIDCプロバイダーのIssuer URL（例: https://accounts.google.com）
OIDC_ISSUER=https://your-oidc-provider.example.com

# OIDCクライアントID
OIDC_CLIENT_ID=your-client-id

# OIDCクライアントシークレット
OIDC_CLIENT_SECRET=your-client-secret

# アプリのベースURL（末尾スラッシュなし）
# コールバックURLは ${APP_URL}/auth/callback になります
APP_URL=http://localhost:3000

# セッション暗号化シークレット（十分にランダムな長い文字列）
# 生成例: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# リッスンポート（省略時: 3000）
PORT=3000

# データベースファイルパス（省略時: ./data/app.db）
# DATABASE_PATH=./data/app.db

# 実行環境（production に設定するとCookieにSecureフラグが付きます）
# NODE_ENV=production
