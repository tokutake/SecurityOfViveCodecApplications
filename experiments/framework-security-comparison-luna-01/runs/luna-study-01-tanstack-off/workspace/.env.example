# Issuer base URL of your OIDC provider
OIDC_ISSUER=https://accounts.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=replace-me
# Public base URL of this app; register ${APP_URL}/auth/callback as redirect URI
APP_URL=http://localhost:3000
# Generate at least 32 characters of random secret
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000
# Optional SQLite file location (defaults to ./data/microsns.sqlite)
# DB_PATH=./data/microsns.sqlite
