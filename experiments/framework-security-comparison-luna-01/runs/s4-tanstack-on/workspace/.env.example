# OIDC Provider settings
OIDC_ISSUER=https://accounts.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Base URL of this application (no trailing slash)
APP_URL=http://localhost:3000

# Session encryption secret (random string, at least 32 chars)
SESSION_SECRET=change-this-to-a-random-string-of-at-least-32-chars

# SQLite database file path (optional, defaults to ./data/app.db)
DATABASE_PATH=./data/app.db

# Port (optional, defaults to 3000)
PORT=3000
